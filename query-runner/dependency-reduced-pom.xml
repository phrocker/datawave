<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>datawave-parent</artifactId>
    <groupId>gov.nsa.datawave</groupId>
    <version>3.8.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>query-runner</artifactId>
  <name>${project.artifactId}</name>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <mainClass>datawave.queryrunner.BaseQueryRunner</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <timestamp>${maven.build.timestamp}</timestamp>
    <version.axiom>1.2.14</version.axiom>
    <version.asm>4.0</version.asm>
    <accumulo.scope>provided</accumulo.scope>
    <rpm.release.number>${timestamp}</rpm.release.number>
    <version.abdera>1.1.3</version.abdera>
    <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    <version.commons-compress>1.21</version.commons-compress>
    <version.bcprov>1.46</version.bcprov>
    <version.commons-pool2>2.6.1</version.commons-pool2>
    <version.commons-net>3.6</version.commons-net>
    <build.properties.0>default</build.properties.0>
    <accumulo.version>${version.accumulo}</accumulo.version>
    <version.protobuf>2.5.0</version.protobuf>
    <version.mrunit>1.0.0</version.mrunit>
    <version.geronimo-activation>1.1</version.geronimo-activation>
    <version.commons-dbutils>1.7</version.commons-dbutils>
    <version.commons-digester>3.2</version.commons-digester>
    <version.jms>1.1</version.jms>
    <version.geronimo-stax>1.0.1</version.geronimo-stax>
  </properties>
</project>
